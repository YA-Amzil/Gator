GATOR_DB_URL=postgres://gator:gator@localhost:5432/gator?sslmode=disable

# Optional: enables Redis-backed caching of user lookups. Leave unset to run
# without a cache — every command works identically either way, just without
# the speedup on the hottest read path (resolving the logged-in user).
GATOR_REDIS_URL=redis://localhost:6379/0
